# Absolute URL of the deployed site, used for canonical links and the sitemap.
# Leave this UNSET rather than blank — a blank value is ignored, and on Vercel
# the deployment URL is detected automatically.
SITE_URL=

# Secret used to sign session cookies. Required in production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# Vercel Blob token, from the Vercel dashboard (Storage -> Blob).
# When set, admin photo uploads go to Blob and persist permanently.
# When unset, uploads are written to public/uploads for local development.
BLOB_READ_WRITE_TOKEN=

# Where the SQLite file lives. Optional.
# DATABASE_PATH=/var/data/fleet-marketplace.db

# Copy the database to a temp directory at startup so it stays writable on a
# read-only filesystem. Detected automatically on Vercel; set 1 or 0 to force.
# EPHEMERAL_DB=1
