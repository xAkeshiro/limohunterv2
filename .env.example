# Absolute URL of the deployed site, used for canonical links and the sitemap.
SITE_URL=http://localhost:3000

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# Optional: override where the SQLite database file lives.
# DATABASE_PATH=/var/data/limohunter.db
