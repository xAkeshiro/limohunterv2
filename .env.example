# ---------------------------------------------------------------- required

# Postgres connection string. Supabase: Project -> Connect -> "Transaction
# pooler" (port 6543). Neon: the pooled connection string. POSTGRES_URL is
# also accepted, which is what the Vercel Supabase integration sets.
# Without either, the app runs on a built-in database (PGlite) that is fine
# locally but RESETS on every restart when deployed.
DATABASE_URL=

# Secret used to sign session cookies. Required in production: without it,
# nobody can sign in. At least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The first administrator. Created on first boot if the account does not
# exist; an existing account is promoted to admin and keeps its password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# ---------------------------------------------------------------- optional

# Absolute URL of the deployed site, used for canonical links and the sitemap.
# Leave this UNSET rather than blank; on Vercel the URL is detected.
# SITE_URL=https://your-site.example

# Vercel Blob token (Vercel dashboard -> Storage -> Blob). Needed for photo
# uploads to persist when deployed.
BLOB_READ_WRITE_TOKEN=

# Sample data loaded once into a fresh database. Inventory is on by default
# (32 illustrative listings, deletable from the admin); demo accounts with the
# published password demo1234 are OFF by default on a hosted database.
# SEED_DEMO_INVENTORY=0
# SEED_DEMO_ACCOUNTS=1

# Connections per server instance to the database. Keep small on serverless.
# DATABASE_POOL_MAX=3

# Where the built-in database keeps its files when DATABASE_URL is unset.
# "memory://" keeps it in memory (used by the test suites).
# PGLITE_DIR=./data/pglite

# Automatic listing photos from Wikimedia Commons. On by default.
# AUTO_PHOTOS=0

# Contact shown in the User-Agent sent to the Wikimedia API.
# WIKIMEDIA_CONTACT=https://your-site.example

# Override the Commons API endpoint (used for testing against a mock).
# COMMONS_API_URL=https://commons.wikimedia.org/w/api.php
